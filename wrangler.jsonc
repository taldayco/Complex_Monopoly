{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monopoly-board",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_DO", "class_name": "GameDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameDO"] }
  ]
}
